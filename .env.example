# PostgreSQL DSN for the separate jennit database (auto-created on first start).
JENNIT_DB_DSN=postgresql://jennit:jennit@127.0.0.1:5432/jennit

# Where uploaded files are spooled, and where reports/exports are written.
JENNIT_SPOOL_ROOT=./spool
JENNIT_DATA_ROOT=./data

# Number of analysis worker threads.
JENNIT_THREADS=16

# Minimum black/white pixel count for annotation (same default as the CLI).
JENNIT_PIXELS_THRESHOLD=5

# Max upload size per file in bytes (default 2 GiB).
JENNIT_MAX_UPLOAD_BYTES=2147483648

# Keep intermediate artifacts under JENNIT_DATA_ROOT/batches/<id>/artifacts/
# after the scan row is committed. Default: false (delete after commit).
JENNIT_KEEP_INTERMEDIATES=false

# Optional bearer token; leave empty for open (internal) access.
JENNIT_API_TOKEN=

# Bind address and port for jennit-server.
JENNIT_HOST=0.0.0.0
JENNIT_PORT=8000
